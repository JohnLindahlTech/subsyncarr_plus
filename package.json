{
  "name": "@johnlindahltech/subsyncarr-plus-plus",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist; rm -rf node_modules; rm -rf build/* && rm -rf build",
    "build": "tsc",
    "start": "node dist/index-server.js",
    "start:legacy": "node dist/index.js",
    "watch": "tsc -w",
    "lint": "eslint .",
    "lint:fix": "prettier --write \"**/*\" && npm run lint -- --fix",
    "test": "vitest run",
    "prepare": "husky || true"
  },
  "main": "./dist/index-server.js",
  "exports": "./dist/index-server.js",
  "files": [
    "dist/",
    "!**/__tests__/**"
  ],
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.11.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "p-queue": "^9.1.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.10",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.2.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.4.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.2",
    "typescript": "~5.4.5",
    "typescript-eslint": "^7.13.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.json": "prettier --write",
    "*.yml": "prettier --write",
    "*.md": "prettier --write"
  }
}
